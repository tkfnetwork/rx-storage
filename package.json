{
  "name": "@tkfnetwork/rx-storage",
  "version": "0.0.6",
  "description": "RxJS wrapper for listening and subscribing to Storage based events",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "prepare": "npm run build",
    "build": "rimraf dist && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "lint": "eslint .",
    "prettier": "prettier src --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "files": [
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@git.kpho.me/kris/rx-storage.git"
  },
  "keywords": [
    "rxjs",
    "storage",
    "localstorage"
  ],
  "author": "Kris Pomphrey <kris@tkf.network>",
  "license": "ISC",
  "bugs": {
    "url": "https://git.kpho.me/kris/rx-storage/issues"
  },
  "homepage": "https://git.kpho.me/kris/rx-storage#readme",
  "peerDependencies": {
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "rxjs": "^7.8.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
